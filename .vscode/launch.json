{

    "version": "0.2.0",
    "configurations": [
        {
            "name": "PYD: Current File, No args",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "stopOnEntry": false
        },
        {
            // works for any RM utility that follows the RMpy.launcher + testing/dev.ini convention:
            // open its .py/.pyw file as the active editor tab, then run this config.
            "name": "PYD: Current File, using dev.ini",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "args": "testing/dev.ini",
            "stopOnEntry": true
        },
        {
            "name": "PYD: Test external files test env",
            "cwd": "C:/Users/Test/RM_test_root",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/Test external files/TestExternalFiles.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/Test external files/testing/test.ini"
            ],
            "stopOnEntry": true
        },
        {
            "name": "Renumber Sort2",
            "cwd": "${workspaceFolder}/DB schema changes/DNA/Renumber_Sort2_in_AuxDNATable",
            "type": "debugpy",
            "request": "launch",
            "program": "renumber_sort2.py",
            "console": "integratedTerminal",
            "args": "",
            "stopOnEntry": true
        },
        {
            "name": "PYD: Build Release",
            "cwd": "${workspaceFolder}/dev util scripts",
            "type": "debugpy",
            "request": "launch",
            "program": "BuildRelease.py",
            "console": "integratedTerminal",
            "stopOnEntry": true
        },
        {
            // the file copying util for use in dev enviornment
            "name": "PYD: DB_util arg=production",
            "cwd": "${workspaceFolder}/dev util scripts",
            "type": "debugpy",
            "request": "launch",
            "program": "DB_util.py",
            "console": "integratedTerminal",
            "args": "production",
            "stopOnEntry": true
        },
        {
            // for use with Powershell
            "name": "PowerShell Launch Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "cwd": "${cwd}"
        }
    ]
}