# lib.ANC-Census-US-FED-1930
# Cursor starts in the Citation Name field

# usage
# [lib.ANC-Census-US-FED-1930]

# clear existing citation name so that it will auto-regenerate
{CTRL+A}{DEL}{TAB}

[Name]{TAB}
[Birth Year]{TAB}

# Skip Date-on-sheet field
{TAB}

_CP [Residence]{TAB}

# Skip Locality field
{TAB}
# Skip County field
{TAB}

[Street Address]{TAB}
[House Number]{TAB}

[Source.Enumeration District]{TAB}

[Source.Page], line {TAB}
[Family Number]{TAB}
[Source.Roll]; FHL [FHL Film]{TAB}
[Record ID]{TAB}

# skip FS record ID
{TAB}
# skip Citation detail
{TAB}

[Page.Access Date]{TAB}

# Enter the Note editor
{RIGHT}
