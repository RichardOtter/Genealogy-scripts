# Skip Locality field
{TAB}
# Skip County field
{TAB}

[Street Name]{TAB}
[House Number]{TAB}

[Source.Enumeration District]{TAB}

[Sheet Number], line {TAB}
[Number of Household in Order of Visitation]{TAB}
[Source.Roll]{TAB}
[Record ID]{TAB}

# skip FS record ID
{TAB}
# skip Citation detail
{TAB}

[Page.Access Date]{TAB}

# Enter the Note editor
{RIGHT}
